# Copia este archivo a .env y cambia los valores antes de usarlo.
# El .env nunca se sube al repositorio (está en .gitignore).

# ---------- MongoDB ----------
# Usuario root que crea el contenedor de Mongo la primera vez
MONGO_USER=cambia_este_usuario
# Sin caracteres especiales como @ : / (van dentro de la URI de conexión)
MONGO_PASSWORD=cambia_esta_clave
MONGO_DB=contactbook

# ---------- API ----------
# Secreto para firmar los JWT
JWT_SECRET=cambia_este_secreto
# Usuario admin que se siembra al iniciar la API
ADMIN_EMAIL=admin@contactbook.com
ADMIN_PASSWORD=cambia_esta_clave_admin
# Origen del frontend que puede llamar a la API
CORS_ORIGIN=http://localhost:8080

# ---------- Web ----------
# URL de la API vista desde el navegador (se incrusta al compilar React)
VITE_API_URL=http://localhost:3000

# ---------- Solo para correr la API sin Docker ----------
# MONGO_URI=mongodb://localhost:27017/contactbook
# PORT=3000
